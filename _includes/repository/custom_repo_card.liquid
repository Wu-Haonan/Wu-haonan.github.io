<a class="custom-repo-card" href="https://github.com/{{ include.owner }}/{{ include.repo }}">
  <div class="repo-card-title">
    <span>{{ include.owner }}/{{ include.repo }}</span>
  </div>

  <p class="repo-card-description">
    {{ include.description }}
  </p>

  <div class="repo-card-meta">
    <span>{{ include.language }}</span>
    {% if include.stars %}
      <span>☆ {{ include.stars }}</span>
    {% endif %}
  </div>
</a>