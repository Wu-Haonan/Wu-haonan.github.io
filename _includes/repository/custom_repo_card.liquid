{% assign repo_url = include.url %}
{% if repo_url == blank %}
  {% assign repo_url = include.full_name | prepend: "https://github.com/" %}
{% endif %}

<a class="custom-repo-card" href="{{ repo_url }}">
  <div class="repo-card-title">{{ include.full_name }}</div>

  <p class="repo-card-description">
    {{ include.description | default: "No description provided." }}
  </p>

  <div class="repo-card-meta">
    {% if include.language %}
      <span>{{ include.language }}</span>
    {% endif %}

    {% if include.stars %}
      <span>☆ {{ include.stars }}</span>
    {% endif %}

    {% if include.forks %}
      <span>Forks {{ include.forks }}</span>
    {% endif %}
  </div>
</a>
