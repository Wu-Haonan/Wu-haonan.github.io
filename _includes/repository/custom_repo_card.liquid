<a class="custom-repo-card" href="{{ include.url }}">
  <div class="repo-card-title">{{ include.full_name }}</div>

  <p class="repo-card-description">
    {{ include.description }}
  </p>

  <div class="repo-card-meta">
    {% if include.language %}
      <span>{{ include.language }}</span>
    {% endif %}

    {% if include.stars %}
      <span>☆ {{ include.stars }}</span>
    {% endif %}

    {% if include.stars %}
      <span>⑂ {{ include.forks }}</span>
    {% endif %}
    
  </div>
</a>

